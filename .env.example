# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=

# --- Cloudinary (images / designs / payment screenshots) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- NextAuth.js ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Google OAuth (via Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMS / OTP Gateway (provider TBD, see SRS Appendix C) ---
OTP_GATEWAY_API_KEY=