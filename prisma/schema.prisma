// ==========================================================
// Custom Printing E-Commerce Platform — Prisma Schema
// Matches the project ERD (database_erd.drawio) — 20 models
// ==========================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================
// ENUMS
// ==========================================================

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum AuthProvider {
  EMAIL
  GOOGLE
  PHONE_OTP
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderPaymentMethod {
  COD_ADVANCE
  FULL_MANUAL_TRANSFER
  CARD_WALLET_COMING_SOON
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  FULL
  REMAINING_COD
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CASH
  CARD_WALLET_COMING_SOON
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BulkOrderStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

enum LandingPageType {
  SINGLE_PRODUCT
  COLLECTION
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  CHECKOUT_VERIFY
}

// ==========================================================
// USERS & AUTH
// ==========================================================

model User {
  id              String   @id @default(cuid())
  name            String
  email           String?  @unique
  phone           String?  @unique
  password        String?
  googleId        String?  @unique
  authProvider    AuthProvider @default(EMAIL)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  role            Role     @default(CUSTOMER)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  addresses         Address[]
  orders            Order[]
  designs           Design[]
  carts             Cart[]
  bulkOrderRequests BulkOrderRequest[]
  blogPosts         BlogPost[]
  otpVerifications  OtpVerification[]
  verifiedPayments  Payment[]          @relation("VerifiedByAdmin")

  @@map("users")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  addressLine String
  city        String
  province    String
  postalCode  String?
  phone       String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ==========================================================
// CATALOG
// ==========================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  products     Product[]
  galleryItems GalleryItem[]
  landingPages LandingPage[]

  @@map("categories")
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  description      String?
  basePrice        Decimal       @db.Decimal(10, 2)
  isCustomizable   Boolean       @default(true)
  isBulkAvailable  Boolean       @default(false)
  status           ProductStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants     ProductVariant[]
  images       ProductImage[]
  designs      Design[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  landingPages LandingPage[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size             String?
  color            String?
  material         String?
  sku              String   @unique
  priceAdjustment  Decimal  @default(0) @db.Decimal(10, 2)
  stock            Int      @default(0)
  image            String?
  isActive         Boolean  @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// ==========================================================
// CUSTOM ORDER BUILDER
// ==========================================================

model Design {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  uploadedImageUrl  String?
  textContent       String?
  fontFamily        String?
  textColor         String?
  overlayPosition   Json?
  previewImageUrl   String?
  createdAt         DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId])
  @@index([productId])
  @@map("designs")
}

// ==========================================================
// CART
// ==========================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?  @unique
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id                   String          @id @default(cuid())
  cartId               String
  cart                 Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId            String
  product              Product         @relation(fields: [productId], references: [id])
  variantId            String
  variant              ProductVariant  @relation(fields: [variantId], references: [id])
  designId             String?
  design               Design?         @relation(fields: [designId], references: [id])
  quantity             Int             @default(1)
  specialInstructions  String?

  @@index([cartId])
  @@map("cart_items")
}

// ==========================================================
// ORDERS
// ==========================================================

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  userId            String?
  user              User?              @relation(fields: [userId], references: [id])
  addressId         String
  address           Address            @relation(fields: [addressId], references: [id])
  subtotal          Decimal            @db.Decimal(10, 2)
  totalAmount       Decimal            @db.Decimal(10, 2)
  advancePercentage Decimal            @default(15) @db.Decimal(5, 2)
  advanceAmount     Decimal            @db.Decimal(10, 2)
  remainingAmount   Decimal            @db.Decimal(10, 2)
  paymentMethod     OrderPaymentMethod
  status            OrderStatus        @default(PENDING_CONFIRMATION)
  whatsappOrderRef  String?
  trackingCode      String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([addressId])
  @@map("orders")
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product         @relation(fields: [productId], references: [id])
  variantId            String
  variant              ProductVariant  @relation(fields: [variantId], references: [id])
  designId             String?
  design               Design?         @relation(fields: [designId], references: [id])
  quantity             Int
  unitPrice            Decimal         @db.Decimal(10, 2)
  lineTotal            Decimal         @db.Decimal(10, 2)
  specialInstructions  String?

  @@index([orderId])
  @@map("order_items")
}

// ==========================================================
// PAYMENTS (COD Advance + Manual Transfer)
// ==========================================================

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type              PaymentType
  method            PaymentMethod
  amount            Decimal       @db.Decimal(10, 2)
  screenshotUrl     String?
  status            PaymentStatus @default(PENDING)
  verifiedByAdminId String?
  verifiedByAdmin   User?         @relation("VerifiedByAdmin", fields: [verifiedByAdminId], references: [id])
  submittedAt       DateTime      @default(now())
  verifiedAt        DateTime?

  @@index([orderId])
  @@map("payments")
}

// ==========================================================
// BULK / CORPORATE ORDERS
// ==========================================================

model BulkOrderRequest {
  id                String          @id @default(cuid())
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  companyName       String?
  contactName       String
  email             String
  phone             String
  productDetails    String
  estimatedQuantity Int
  message           String?
  status            BulkOrderStatus @default(NEW)
  createdAt         DateTime        @default(now())

  @@map("bulk_order_requests")
}

// ==========================================================
// GALLERY / PORTFOLIO
// ==========================================================

model GalleryItem {
  id          String    @id @default(cuid())
  title       String
  imageUrl    String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  description String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([categoryId])
  @@map("gallery_items")
}

// ==========================================================
// LANDING PAGES (ADS)
// ==========================================================

model LandingPage {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  type        LandingPageType
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id])
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  bannerImage String?
  adCopy      String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@map("landing_pages")
}

// ==========================================================
// HERO BANNERS (Home Page Slider — admin managed)
// ==========================================================

model HeroBanner {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_banners")
}

// ==========================================================
// SETTINGS (admin configurable values)
// ==========================================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ==========================================================
// CONTACT / SUPPORT
// ==========================================================

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("contact_messages")
}

// ==========================================================
// BLOG (Phase 2 — optional)
// ==========================================================

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  coverImage  String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([authorId])
  @@map("blog_posts")
}

// ==========================================================
// OTP VERIFICATION (Phone signup/login/checkout)
// ==========================================================

model OtpVerification {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  phone     String
  code      String
  purpose   OtpPurpose
  isUsed    Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([phone])
  @@map("otp_verifications")
}
